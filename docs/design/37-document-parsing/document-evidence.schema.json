{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deepagent:document-evidence:v2",
  "title": "DeepAgent document evidence v2",
  "description": "Complete backend-produced evidence.json inside an application/zip bundle; page image paths are package-relative. Not a paginated tool result.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "document-evidence-v2"
    },
    "adaptation_version": {
      "type": "string",
      "pattern": "^document-adaptation-v[0-9]+$"
    },
    "layout_version": {
      "const": "document-layout-v1"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "paddle",
        "glm"
      ]
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      },
      "maxItems": 1000
    },
    "images": {
      "$ref": "#/$defs/images"
    }
  },
  "required": [
    "schema_version",
    "adaptation_version",
    "layout_version",
    "document_id",
    "provider",
    "model",
    "status",
    "source",
    "summary",
    "warnings",
    "pages",
    "images"
  ],
  "$defs": {
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "attachment"
        },
        "file_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
        }
      },
      "required": [
        "type",
        "file_id"
      ]
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "skill"
        },
        "skill_code": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "type",
        "skill_code",
        "path"
      ]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "char_start",
        "char_end"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_pages": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "parsed_pages": {
          "type": "integer",
          "minimum": 0
        },
        "page_numbers_known": {
          "type": "boolean"
        },
        "missing_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "coverage": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        }
      },
      "required": [
        "source_pages",
        "parsed_pages",
        "page_numbers_known",
        "missing_pages",
        "coverage"
      ]
    },
    "preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use_doc_orientation_classify": {
          "type": "boolean"
        },
        "use_doc_unwarping": {
          "type": "boolean"
        },
        "angle": {
          "type": "number"
        }
      },
      "required": []
    },
    "fileReference": {
      "additionalProperties": false,
      "properties": {
        "storage": {
          "enum": [
            "local",
            "platform"
          ],
          "title": "Storage",
          "type": "string"
        },
        "file_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,256}$"
        },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\\\x00-\\x1f]+$"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1
        },
        "mime": {
          "const": "application/zip",
          "default": "application/zip",
          "title": "Mime",
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "schema_version": {
          "const": "document-evidence-v2"
        }
      },
      "required": [
        "storage",
        "file_id",
        "file_name",
        "byte_size",
        "mime",
        "sha256",
        "schema_version"
      ],
      "title": "EvidenceFileReference",
      "type": "object",
      "allOf": [
        {
          "if": {
            "properties": {
              "storage": {
                "const": "local"
              }
            }
          },
          "then": {
            "properties": {
              "file_id": {
                "pattern": "^local_"
              }
            }
          },
          "else": {
            "properties": {
              "file_id": {
                "not": {
                  "pattern": "^local_"
                }
              }
            }
          }
        }
      ]
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^p[1-9][0-9]*:b[1-9][0-9]*$",
          "description": "Unique only within document_id. p refers to page_ordinal, never an inferred physical page."
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "bbox": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 4,
              "maxItems": 4
            }
          ]
        },
        "location_status": {
          "enum": [
            "available",
            "missing_bbox",
            "invalid_bbox",
            "unknown_page",
            "missing_page_size",
            "outside_page",
            "empty_bbox"
          ]
        },
        "char_start": {
          "type": "integer",
          "minimum": 0
        },
        "char_end": {
          "type": "integer",
          "minimum": 0
        },
        "mapping_status": {
          "enum": [
            "exact",
            "appended",
            "no_text"
          ]
        },
        "native_content": {
          "type": "string"
        },
        "polygon_points": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "minItems": 3
            }
          ]
        }
      },
      "required": [
        "block_id",
        "ordinal",
        "label",
        "bbox",
        "location_status",
        "char_start",
        "char_end",
        "mapping_status",
        "native_content",
        "polygon_points"
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "page_ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "const": "markdown"
        },
        "content": {
          "type": "string",
          "description": "Fixed layout reading view; character spans count Unicode code points."
        },
        "native_content": {
          "type": "string",
          "description": "Provider page Markdown before readable adaptation, except unsafe transport references are redacted."
        },
        "width": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "number",
              "exclusiveMinimum": 0
            }
          ]
        },
        "coordinate_space": {
          "enum": [
            "paddle_processed_page_pixels",
            "glm_page_pixels",
            "unknown"
          ]
        },
        "original_page_mapping": {
          "enum": [
            "unverified",
            "unavailable",
            "unknown_page",
            "conflicting_page_size"
          ]
        },
        "preprocessing": {
          "$ref": "#/$defs/preprocessing"
        },
        "reported_page_sizes": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "unmapped_spans": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span"
          }
        },
        "image": {
          "$ref": "#/$defs/image"
        }
      },
      "required": [
        "page_number",
        "page_ordinal",
        "format",
        "content",
        "native_content",
        "width",
        "height",
        "coordinate_space",
        "original_page_mapping",
        "preprocessing",
        "blocks",
        "unmapped_spans",
        "image"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage": {
          "enum": [
            "local",
            "platform",
            "skill"
          ]
        },
        "resource": {
          "oneOf": [
            {
              "$ref": "#/$defs/attachment"
            },
            {
              "$ref": "#/$defs/skill"
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA256 of original source file bytes, not the ZIP or evidence.json."
        }
      },
      "required": [
        "storage",
        "resource",
        "sha256"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "storage": {
                "const": "skill"
              }
            }
          },
          "then": {
            "properties": {
              "resource": {
                "$ref": "#/$defs/skill"
              }
            }
          },
          "else": {
            "properties": {
              "resource": {
                "$ref": "#/$defs/attachment"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "storage": {
                "const": "local"
              }
            }
          },
          "then": {
            "properties": {
              "resource": {
                "properties": {
                  "file_id": {
                    "pattern": "^local_"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "storage": {
                "const": "platform"
              }
            }
          },
          "then": {
            "properties": {
              "resource": {
                "properties": {
                  "file_id": {
                    "not": {
                      "pattern": "^local_"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "complete",
            "partial",
            "unavailable"
          ]
        },
        "expected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "saved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "missing_page_ordinals": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true,
          "maxItems": 1000
        }
      },
      "required": [
        "status",
        "expected",
        "saved",
        "missing_page_ordinals"
      ]
    },
    "image": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "saved"
            },
            "path": {
              "type": "string",
              "pattern": "^pages/page-[0-9]{4,}\\.(jpg|png)$"
            },
            "mime": {
              "enum": [
                "image/jpeg",
                "image/png"
              ]
            },
            "byte_size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20971520
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "coordinate_mapping": {
              "enum": [
                "matched",
                "unverified",
                "dimension_mismatch"
              ]
            },
            "reason_code": {
              "$ref": "#/$defs/imageReasonCode"
            },
            "role": {
              "enum": [
                "processed_page",
                "layout_visualization"
              ]
            },
            "annotated": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "path",
            "mime",
            "byte_size",
            "sha256",
            "width",
            "height",
            "coordinate_mapping",
            "role",
            "annotated"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "coordinate_mapping": {
                    "enum": [
                      "unverified",
                      "dimension_mismatch"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "reason_code"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "role": {
                    "const": "processed_page"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "then": {
                "properties": {
                  "annotated": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "role": {
                    "const": "layout_visualization"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "then": {
                "properties": {
                  "annotated": {
                    "const": true
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "coordinate_mapping": {
                    "const": "matched"
                  }
                }
              },
              "then": {
                "not": {
                  "required": [
                    "reason_code"
                  ]
                }
              }
            },
            {
              "if": {
                "properties": {
                  "coordinate_mapping": {
                    "const": "dimension_mismatch"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason_code": {
                    "const": "dimension_mismatch"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "coordinate_mapping": {
                    "const": "unverified"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason_code": {
                    "enum": [
                      "exif_orientation",
                      "coordinate_space_unverified",
                      "page_dimensions_unknown"
                    ]
                  }
                }
              }
            }
          ],
          "dependentRequired": {
            "role": [
              "annotated"
            ],
            "annotated": [
              "role"
            ]
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "not_provided",
                "failed"
              ]
            },
            "coordinate_mapping": {
              "const": "unverified"
            },
            "reason_code": {
              "$ref": "#/$defs/imageReasonCode"
            },
            "role": {
              "enum": [
                "processed_page",
                "layout_visualization"
              ]
            },
            "annotated": {
              "type": "boolean"
            }
          },
          "required": [
            "status",
            "coordinate_mapping",
            "reason_code"
          ],
          "dependentRequired": {
            "role": [
              "annotated"
            ],
            "annotated": [
              "role"
            ]
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "role": {
                    "const": "processed_page"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "then": {
                "properties": {
                  "annotated": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "role": {
                    "const": "layout_visualization"
                  }
                },
                "required": [
                  "role"
                ]
              },
              "then": {
                "properties": {
                  "annotated": {
                    "const": true
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "not_provided"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason_code": {
                    "const": "not_provided"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "failed"
                  }
                }
              },
              "then": {
                "properties": {
                  "reason_code": {
                    "enum": [
                      "unsupported_image_source",
                      "download_timeout",
                      "download_budget_exceeded",
                      "unsafe_url",
                      "artifact_access_denied",
                      "result_too_large",
                      "rate_limited",
                      "network_error",
                      "service_error",
                      "permission_denied",
                      "invalid_image",
                      "image_pixels_exceeded",
                      "unsupported_image_format",
                      "animated_image",
                      "image_download_failed"
                    ]
                  }
                }
              }
            }
          ]
        }
      ]
    },
    "imageReasonCode": {
      "enum": [
        "not_provided",
        "unsupported_image_source",
        "download_timeout",
        "download_budget_exceeded",
        "unsafe_url",
        "artifact_access_denied",
        "result_too_large",
        "rate_limited",
        "network_error",
        "service_error",
        "permission_denied",
        "invalid_image",
        "image_pixels_exceeded",
        "unsupported_image_format",
        "animated_image",
        "image_download_failed",
        "exif_orientation",
        "coordinate_space_unverified",
        "dimension_mismatch",
        "page_dimensions_unknown"
      ],
      "description": "Closed operational taxonomy. Never upstream exception text, credentials, body or URL."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "provider": {
            "const": "paddle"
          }
        }
      },
      "then": {
        "properties": {
          "pages": {
            "items": {
              "properties": {
                "image": {
                  "properties": {
                    "role": {
                      "const": "processed_page"
                    },
                    "annotated": {
                      "const": false
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "provider": {
            "const": "glm"
          }
        }
      },
      "then": {
        "properties": {
          "pages": {
            "items": {
              "properties": {
                "image": {
                  "properties": {
                    "role": {
                      "const": "layout_visualization"
                    },
                    "annotated": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
