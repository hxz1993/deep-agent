# -*- coding: utf-8 -*-
"""发起 0501200206。同一四维再开一轮插入新 instance_id，不覆盖旧实例。被驳回不能走这里。

附件规则（2026-09-21 起）：**只带本轮新传的附件**（used_instance_id 为空的）。
上一轮已认领给别的实例的附件不再重复带上，且**原样保留**（不摘旗、不改归属），
所以旧实例 ↔ 附件的归属仍然可查，那一轮被驳回后重提也仍能找回自己的附件。
"""
import json
import re
from base64 import b64encode
from datetime import datetime
from urllib.parse import parse_qs, urlencode, urlsplit
from xml.etree import ElementTree as ET

import pandas as pd
import requests
from deepfos.element.base import ElementBase
from deepfos.element.datatable import DataTableDeepModel
from deepfos.options import OPTION

from .deepagent_demo.deepagent_mcp_client import AGENT_CODE, MCP_URL, run

PATH = "/Application/SANY/11_Approval_Process/"
TEMPLATE = "811708849152061474"
FORM_CODES = ("B_Exp01", "B_Exp03", "B_Exp04")
COLS = [
    "year", "scenario", "version", "entity", "instance_id",
    "complete_status", "lock_flag", "starter", "budget_link",
    "last_update_time", "comment", "instance_title",
]

# 回填边界只约束静态 HTML 和必要内容，具体版式由 Skill 的模板维护。
OPINION_TAGS = set("div h2 h3 h4 p table thead tbody tr th td span strong b em".split())
OPINION_CSS = set("""
    background background-color border border-bottom border-collapse border-left border-radius
    border-right border-top box-sizing color display flex flex-wrap font font-family font-size
    font-weight gap letter-spacing line-height margin margin-bottom margin-left margin-right
    margin-top max-width min-width overflow-wrap overflow-x padding text-align width
""".split())


def format_opinion(answer):
    """确认业务栏目齐备，限制表单可嵌入的 HTML。字段和表格布局由 Skill 处理。"""
    raw = (answer or "").strip()
    fence = re.fullmatch(r"```(?:html)?\s*\n(.*)\n```", raw, re.I | re.S)
    if fence:
        raw = fence.group(1).strip()
    if not raw or len(raw) > 100_000 or "<!" in raw or "<?" in raw:
        raise ValueError("三一助手未返回有效的审批 HTML")
    try:
        root = ET.fromstring(raw)
    except ET.ParseError as exc:
        raise ValueError("三一助手返回的审批 HTML 不完整") from exc
    if root.tag != "div" or root.attrib.pop("data-report", None) != "bpp-sales-opinion":
        raise ValueError("未收到 BPP 审批模式的模板结果，请核对 sany-demo-workflows 的版本与关联")
    sections = set()
    for node in root.iter():
        section = node.attrib.pop("data-section", None)
        if section and "".join(node.itertext()).strip():
            sections.add(section)
        if node.tag not in OPINION_TAGS or set(node.attrib) - {"style"}:
            raise ValueError("审批 HTML 包含未渲染字段或不支持的标签、属性")
        for declaration in node.get("style", "").split(";"):
            if declaration.strip():
                name, _, value = declaration.partition(":")
                if name.strip() not in OPINION_CSS or not re.fullmatch(r"[A-Za-z0-9 #%.,'/-]+", value.strip()):
                    raise ValueError("审批 HTML 包含不支持的样式")
    required = {"scope", "summary", "shares", "strategy", "metrics", "checks", "gaps", "sources"}
    if not required.issubset(sections):
        raise ValueError("审批 HTML 缺少必需的业务栏目")
    return ET.tostring(root, encoding="unicode", method="html")


def read_approval_html(task):
    files = [
        (artifact.get("artifactId"), part.get("url"))
        for artifact in task.get("artifacts") or []
        for part in artifact.get("parts") or []
        if part.get("filename") == "approval.html"
    ]
    if len(files) != 1:
        raise ValueError(f"应交付一份 approval.html，实际收到 {len(files)} 份")
    artifact_id, url = files[0]
    task_id = task["task_id"]
    if not all(isinstance(value, str) and re.fullmatch(r"[A-Za-z0-9_-]+", value) for value in (task_id, artifact_id)):
        raise ValueError("审批文件的任务或产物编号无效")
    # 网关未返回公开 URL 时，同一 MCP 服务仍可按任务和产物编号取件。
    service = MCP_URL.rsplit("/", 1)[0]
    expected = urlsplit(f"{service}/tasks/{task_id}/artifacts/{artifact_id}/download")
    target = urlsplit(url) if url else expected
    if target not in (expected, expected._replace(scheme="https")):
        raise ValueError("审批文件下载地址与本次任务的客户网关地址不匹配")

    context = {key.lower(): value for key, value in OPTION.api.header.items()}
    auth = next((key for key in ("x-deepfos-key", "authorization", "token", "x-user-token") if context.get(key)), None)
    if not auth or not context.get("app"):
        raise ValueError("下载审批文件需要发起任务时的应用和平台凭据")
    headers = {key: context[key] for key in ("app", "space", auth) if context.get(key)}
    try:
        response = requests.get(target.geturl(), headers=headers, allow_redirects=False, timeout=30)
        if response.status_code != 200:
            raise ValueError(f"审批文件下载失败（HTTP {response.status_code}）")
        return response.content.decode("utf-8")
    except requests.RequestException as exc:
        raise ValueError("审批文件下载失败，请检查客户网关连接") from exc
    except UnicodeDecodeError as exc:
        raise ValueError("审批文件不是有效的 UTF-8 文本") from exc


def generate_opinion(context, attachments=None):
    if AGENT_CODE != "sanyi-mcp-001":
        raise ValueError("当前 deepagent_mcp_client 未指向三一发布 sanyi-mcp-001，请检查客户环境的客户端")
    question = "【BPP 销售预算审批回填】按 sany-demo-workflows 审批模式处理以下送审资料，本轮交付 approval.html 文件。\n"
    task = run(
        question=question + json.dumps(context, ensure_ascii=False, allow_nan=False),
        attachments=attachments, wait_seconds=30,
    )
    task_id = task["task_id"]
    while task["status"] in ("TASK_STATE_SUBMITTED", "TASK_STATE_WORKING"):
        task = run(task_id=task_id, wait_seconds=30)
    if task["status"] != "TASK_STATE_COMPLETED":
        detail = (task.get("status_message") or "")[:360]
        raise ValueError(f"三一助手任务 {task_id} 状态 {task['status']}：{detail}")
    try:
        return format_opinion(read_approval_html(task))
    except ValueError as exc:
        raise ValueError(f"三一助手任务 {task_id}：{exc}") from exc


def form_link(picked):
    s = str(picked or "").strip()
    url = urlsplit(s)
    if url.scheme in ("https", "http") and url.hostname:
        return s
    code = next((name for name in FORM_CODES if name in s), None)
    if not code:
        return ""
    info = ElementBase.check_exist(code, ele_type="GRD", silent=False)
    headers = {key.lower(): value for key, value in OPTION.api.header.items()}
    if not headers.get("app") or not headers.get("space") or not info.folderId or not info.moduleId:
        raise ValueError("无法确定预算表单的应用、空间、目录或组件，请传客户环境的完整 budget_link")
    context = urlencode({"appId": headers["app"], "space": headers["space"]})
    gateway = urlsplit(MCP_URL)
    return f"{gateway.scheme}://{gateway.netloc}/element-deep-table/2-0-0/?" + urlencode({
        "elementName": code, "folderId": info.folderId, "moduleId": info.moduleId,
        "sign": b64encode(context.encode()).decode("ascii"),
    })


def val(src, *keys):
    src = src or {}
    for k in keys:
        x = src.get(k)
        if isinstance(x, list):
            x = x[0] if x else ""
        if x is not None and str(x).strip():
            return str(x).strip()
    return ""


def where(year, scenario, version, entity):
    parts = []
    for name, x in [("year", year), ("scenario", scenario), ("version", version), ("entity", entity)]:
        s = str(x or "").strip()
        if not re.match(r"^[A-Za-z0-9_\-]+$", s):
            raise ValueError(f"{name} 非法")
        parts.append(f"{name}='{s}'")
    return " and ".join(parts)


def row(name, w):
    df = DataTableDeepModel(element_name=name, path=PATH).select(where=w)
    if df is None or df.empty:
        return {}
    if "last_update_time" in df.columns:
        df = df.sort_values("last_update_time", ascending=False)
    return df.iloc[0].to_dict()


def put_status(data):
    t = DataTableDeepModel(element_name="bud_appr_status", path=PATH)
    rec = {c: data.get(c) for c in COLS}
    biz = val(rec, "complete_status") or "10"
    rec["complete_status"] = biz
    # 锁数标志：审批中(10) / 审批完毕(99) 都锁；99 由值列表 Bud_Appr_Biz_Status 定义
    rec["lock_flag"] = "1" if biz in ("10", "99") else "0"
    rec["last_update_time"] = datetime.now()
    t.insert_df(pd.DataFrame([rec]))
    return rec


def call_bpp(code, env, body):
    env = (env or "TEST").upper()
    if env not in ("TEST", "PROD"):
        raise ValueError("env 只能是 TEST 或 PROD")
    cfg = row("bud_appr_api_cfg", f"api_code='{code}' and env='{env}'")
    if not cfg:
        raise ValueError(f"无接口配置 {code}/{env}，到 B_Appr_Api_Cfg 补行")
    if not val(cfg, "auth_key"):
        raise ValueError(f"未填 authKey，到 B_Appr_Api_Cfg 补 {code}/{env} 的钥")
    url = val(cfg, "base_url").rstrip("/") + val(cfg, "api_path")
    headers = {
        "Content-Type": "application/json",
        "appId": val(cfg, "app_id") or "EPM",
        "authKey": val(cfg, "auth_key"),
    }
    resp = requests.post(url, headers=headers, json=body, timeout=60)
    print("HTTP", resp.status_code, resp.text[:1500])
    data = resp.json()
    if resp.status_code >= 400 or data.get("failed") is True:
        raise ValueError(f"BPP 失败 {resp.status_code}: {data}")
    return data


def main(p1, p2):
    p2 = p2 or {}
    preview_flag = str(p2.get("preview_only", False)).strip().lower()
    if preview_flag not in ("true", "1", "false", "0"):
        raise ValueError("preview_only 请传 true 或 false")
    preview = preview_flag in ("true", "1")
    year = val(p2, "Year", "year")
    version = val(p2, "Version", "version")
    entity = val(p2, "Entity", "entity")
    scenario = val(p2, "Scenario", "scenario") or "Budget"
    submitter = val(p2, "user", "User")
    bpp_user = val(p2, "userDomainNo")
    env = val(p2, "env") or "TEST"
    bu_name = val(p2, "bu_name", "EntityName") or entity
    if not all([year, version, entity]):
        raise ValueError("需要 Year / Version / Entity")
    if not preview and not submitter:
        raise ValueError("需要 user")
    if not preview and not bpp_user:
        raise ValueError("需要 userDomainNo（BPP 账号）")

    w = where(year, scenario, version, entity)
    if not preview and val(row("bud_appr_status", w), "complete_status") == "20":
        raise ValueError("已被驳回，请走重新提交")

    picked = val(p2, "budget_link", "form_code", "form", "readonly_ux", "elementName")
    link = form_link(picked)
    if not link.startswith("http"):
        raise ValueError("请先选择表单")
    url = urlsplit(link)
    params = parse_qs(url.query, keep_blank_values=True)
    params.update(year=year, scenario=scenario, version=version, entity=entity)
    link = url._replace(query=urlencode(params, doseq=True)).geturl()

    # 只带「还没被任何实例认领过」的附件（used_instance_id 为空）。
    # 已经认领过的 = 上一轮带过的：本轮**不带**，而且**一个字段都不动** ——
    #   ① 归属（used_instance_id）留着，旧实例 ↔ 附件仍然查得到；
    #   ② 万一那个实例后来被驳回，重提时还能按 used_instance_id 把这些附件找回来
    #      ⇒ 所以这里**不能摘旗**：摘旗会让「审批中又发起一轮」之后的再提丢掉附件。
    # 判断放 Python 里做，不用 `is null / <> / or` 这类 where 语法（未经验证，避免踩坑）。
    all_rows = []
    if not preview:
        files = DataTableDeepModel(element_name="bud_appr_file", path=PATH)
        df = files.select(where=w + " and attach_flag='1'")
        if df is not None and not df.empty:
            all_rows = df.to_dict(orient="records")
    carried = [r for r in all_rows if not val(r, "used_instance_id")]
    infos = [{"id": val(r, "file_id"), "fdName": val(r, "fd_name")}
             for r in carried if val(r, "file_id") and val(r, "fd_name")]
    if isinstance(p2.get("fileInfos"), list):
        infos = p2["fileInfos"]
    infos = infos or None
    scene = val(p2, "ScenarioName", "scenario_name") or scenario
    title = val(p2, "instanceTitle") or f"预算编制详版表单审批流程发起_{scene} -- {datetime.now().strftime('%Y%m%d')}"
    comment = val(p2, "comment") or f"{bu_name}预算编制详版表单审批流程发起"

    context = {
        "年度": year, "期间": val(p2, "Period", "period") or "以表单期间为准",
        "场景": scenario, "场景名称": scene, "版本": version, "组织编码": entity, "组织名称": bu_name,
        "表单": {k: params[k][0] for k in ("elementName", "folderId", "moduleId") if k in params},
    }
    attachment_names = [item["fdName"] for item in infos or [] if isinstance(item, dict) and item.get("fdName")]
    if attachment_names:
        context["BPP附件名称（仅目录）"] = attachment_names
    if p2.get("approval_evidence"):
        context["送审补充材料"] = p2["approval_evidence"]
    opinion = generate_opinion(context, p2.get("attachments"))
    if preview:
        return {"preview_only": True, "approval_opinion": opinion}

    data = call_bpp("0501200206", env, {
        "idempotentSeqNo": val(p2, "idempotentSeqNo") or f"{TEMPLATE}-{year}-{scenario}-{version}-{entity}-{datetime.now().strftime('%Y%m%d%H%M%S')}",
        "userDomainNo": bpp_user,
        "templateCode": val(p2, "templateCode") or TEMPLATE,
        "instanceTitle": title,
        "variables": {},
        "formVariables": {
            "Year": year,
            "Version": version,
            "bu_name": bu_name,
            "user": submitter,
            "budget_link": link,
            "approval_opinion": opinion,
        },
        "additionalTag": {"year": year, "scenario": scenario, "version": version, "entity": entity},
        "comment": comment,
        "fileInfos": infos,
    })
    payload = data.get("data", data) if isinstance(data, dict) else data
    if isinstance(payload, list) and payload:
        payload = payload[0]
    instance_id = (payload.get("instanceId") or payload.get("prcsInstId")) if isinstance(payload, dict) else None
    if not instance_id:
        raise ValueError(f"BPP 回包没有 instanceId: {data}")

    saved = put_status({
        "year": year, "scenario": scenario, "version": version, "entity": entity,
        "instance_id": instance_id, "complete_status": "10",
        "starter": submitter, "budget_link": link,
        "comment": comment, "instance_title": title,
    })
    if carried:
        for rec in carried:
            rec["used_instance_id"] = instance_id      # 本轮带上的，认领给新实例
        # 按 file_id 精确定位后删除再写回：**只动这几行**，已认领过的行完全不动。
        # （不能用 `delete(where=w + " and attach_flag='1'")` 整批删再补写，
        #   那样会把已认领的行也删掉重建，与"原样不动"的承诺不符。）
        for rec in carried:
            fid = val(rec, "file_id")
            if fid and re.match(r"^[A-Za-z0-9_\-]+$", fid):
                files.delete(where=w + f" and file_id='{fid}'")
        files.insert_df(pd.DataFrame(carried))
    return {
        "success": 1, "biz_status": "10", "lock_flag": saved.get("lock_flag"),
        "approval_opinion": opinion,
        "instance_id": instance_id, "instance_title": title, "comment": comment,
        "fileInfos": infos, "file_count": len(carried),
        "skipped_count": len(all_rows) - len(carried),
    }
