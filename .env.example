# Copy to .env and fill in. All app settings are prefixed with DEEP_AGENT_.

# PostgreSQL connection. Leave empty to use in-memory session store (no persistence).
DEEP_AGENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deep_agent

# Provider API keys (set the one(s) matching your LLM model presets).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Loop safety limits.
DEEP_AGENT_MAX_REQUESTS=12
# Leave empty to disable the token cap.
DEEP_AGENT_MAX_TOTAL_TOKENS=

# Optional dedicated model for AI session titles (empty = fallback to chat model or text truncate).
# DEEP_AGENT_TITLE_MODEL=
# DEEP_AGENT_TITLE_MODEL_BASE_URL=
# DEEP_AGENT_TITLE_MODEL_API_KEY=

# Paths for declarative extension.
# MCP servers are stored in PostgreSQL (mcp_servers table) and managed via
# GET/POST/PATCH/DELETE /api/v1/mcp or the admin UI at /admin.
# 默认指向 deep_agent/skills；一般无需修改。
# DEEP_AGENT_SKILLS_DIR=
# Cursor SKILL.md skills. Comma-separated list of directories; each
# subdirectory with a SKILL.md becomes one cursor-skill:<name> capability.
# 默认指向仓库根目录 .cursor/skills。
# DEEP_AGENT_CURSOR_SKILLS_DIR=
