{
  "tools": [
    {
      "name": "list_agents",
      "description": "List enabled Agent publications.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "title": "PublicInput",
        "type": "object"
      }
    },
    {
      "name": "submit_task",
      "description": "Send a message to a published Agent. Supply a stable message_id for safe retries.",
      "inputSchema": {
        "$defs": {
          "Attachment": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 255,
                "minLength": 1,
                "title": "Name",
                "type": "string"
              },
              "media_type": {
                "maxLength": 255,
                "minLength": 1,
                "title": "Media Type",
                "type": "string"
              },
              "data_base64": {
                "maxLength": 11184812,
                "minLength": 1,
                "title": "Data Base64",
                "type": "string"
              }
            },
            "required": [
              "name",
              "media_type",
              "data_base64"
            ],
            "title": "Attachment",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "message_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Message Id",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 65536,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Text"
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Data"
          },
          "attachments": {
            "items": {
              "$ref": "#/$defs/Attachment"
            },
            "maxItems": 20,
            "title": "Attachments",
            "type": "array"
          },
          "context_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Context Id"
          },
          "reference_task_ids": {
            "items": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 10,
            "title": "Reference Task Ids",
            "type": "array"
          },
          "agent_code": {
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Agent Code",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "agent_code"
        ],
        "title": "SubmitTool",
        "type": "object"
      }
    },
    {
      "name": "get_task",
      "description": "Read task status, results, and artifact references.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Task Id",
            "type": "string"
          },
          "history_length": {
            "anyOf": [
              {
                "maximum": 50,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "History Length"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "GetTool",
        "type": "object"
      }
    },
    {
      "name": "list_tasks",
      "description": "List recent tasks started for this Agent using the configured App.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "context_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Context Id"
          },
          "state": {
            "anyOf": [
              {
                "enum": [
                  "submitted",
                  "working",
                  "input_required",
                  "auth_required",
                  "completed",
                  "failed",
                  "canceled",
                  "rejected"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "State"
          },
          "page_size": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "title": "Page Size",
            "type": "integer"
          },
          "cursor": {
            "anyOf": [
              {
                "maxLength": 4096,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Cursor"
          },
          "agent_code": {
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "title": "Agent Code",
            "type": "string"
          }
        },
        "required": [
          "agent_code"
        ],
        "title": "ListTool",
        "type": "object"
      }
    },
    {
      "name": "reply_task",
      "description": "Supply requested input to an existing task. Use the returned question_id as reply_to.",
      "inputSchema": {
        "$defs": {
          "Attachment": {
            "additionalProperties": false,
            "properties": {
              "name": {
                "maxLength": 255,
                "minLength": 1,
                "title": "Name",
                "type": "string"
              },
              "media_type": {
                "maxLength": 255,
                "minLength": 1,
                "title": "Media Type",
                "type": "string"
              },
              "data_base64": {
                "maxLength": 11184812,
                "minLength": 1,
                "title": "Data Base64",
                "type": "string"
              }
            },
            "required": [
              "name",
              "media_type",
              "data_base64"
            ],
            "title": "Attachment",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "message_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Message Id",
            "type": "string"
          },
          "text": {
            "anyOf": [
              {
                "maxLength": 65536,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Text"
          },
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Data"
          },
          "attachments": {
            "items": {
              "$ref": "#/$defs/Attachment"
            },
            "maxItems": 20,
            "title": "Attachments",
            "type": "array"
          },
          "reply_to": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Reply To"
          },
          "task_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Task Id",
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "task_id"
        ],
        "title": "ReplyTool",
        "type": "object"
      }
    },
    {
      "name": "cancel_task",
      "description": "Cancel a task.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Task Id",
            "type": "string"
          }
        },
        "required": [
          "task_id"
        ],
        "title": "TaskTool",
        "type": "object"
      }
    },
    {
      "name": "get_artifact",
      "description": "Get an authorized file artifact reference.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Task Id",
            "type": "string"
          },
          "artifact_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Artifact Id",
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "artifact_id"
        ],
        "title": "ArtifactTool",
        "type": "object"
      }
    }
  ]
}
