# Copy to .env and fill in. All app settings are prefixed with DEEP_AGENT_.

# PostgreSQL connection. Leave empty to use in-memory session store (no persistence).
DEEP_AGENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deep_agent

# Provider API keys (set the one(s) matching your LLM model presets).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Loop safety limits.
DEEP_AGENT_MAX_REQUESTS=30
# Leave empty to disable the token cap.
DEEP_AGENT_MAX_TOTAL_TOKENS=

# Context compaction is enabled automatically for model presets with
# context_window_tokens configured.
DEEP_AGENT_CONTEXT_COMPACTION_TRIGGER_RATIO=0.80
DEEP_AGENT_CONTEXT_COMPACTION_TARGET_RATIO=0.55
DEEP_AGENT_CONTEXT_SUMMARY_TIMEOUT=300
# Advanced deterministic pruning applied only to the summary-model copy of an
# oversized inline tool result. The persisted Event or Artifact is unchanged.
DEEP_AGENT_CONTEXT_TOOL_PRUNE_THRESHOLD=8192
DEEP_AGENT_CONTEXT_TOOL_PRUNE_HEAD=4096
DEEP_AGENT_CONTEXT_TOOL_PRUNE_TAIL=1024
# AI session title auxiliary model is configured in admin UI → 辅助模型 tab.
# The following env vars are only used by integration tests to seed sqlite auxiliary_model_configs:
# DEEP_AGENT_TITLE_MODEL=
# DEEP_AGENT_TITLE_MODEL_BASE_URL=
# DEEP_AGENT_TITLE_MODEL_API_KEY=
# DEEP_AGENT_TITLE_GENERATION_TIMEOUT=30

# Attachment upload limits. Text, DOCX and XLSX are read on demand only when
# the Agent explicitly enables the attachment capability.
DEEP_AGENT_UPLOAD_MAX_SIZE_MB=20
DEEP_AGENT_UPLOAD_MAX_COUNT=10
# Leave empty to use the built-in MIME allowlist.
DEEP_AGENT_UPLOAD_ALLOWED_MIMES=

# Paths for declarative extension.
# MCP servers are stored in PostgreSQL (mcp_servers table) and managed via
# GET/POST/PATCH/DELETE /api/v1/mcp or the Console configuration center.
# 默认指向仓库根目录 skills/；一般无需修改。
# DEEP_AGENT_SKILLS_DIR=
